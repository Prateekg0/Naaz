
<%- include('./partials/header') %>

    <% if (error.length> 0) { %>
        <div class="fixed top-5 left-1/2 -translate-x-1/2 z-50 w-[90%] sm:w-auto p-3 rounded-md bg-red-500 shadow-lg">
            <span class="text-white">
                <%= error %>
            </span>
        </div>
        <% } %>

            <div class="w-full min-h-screen flex flex-col lg:flex-row px-4 sm:px-8 lg:px-16 py-8 lg:py-0">

                <!-- Register Section -->
                <div class="w-full lg:w-1/2 flex items-center justify-center py-8 lg:py-0">
                    <div class="w-full max-w-md px-2 sm:px-4">

                        <h3 class="text-3xl sm:text-4xl font-medium">
                            Welcome to <span class="text-blue-400 font-semibold">Naaz</span>
                        </h3>

                        <h4 class="text-xl sm:text-2xl mb-5 mt-2">
                            Create your account
                        </h4>

                        <form autocomplete="off" action="/users/register" method="post">

                            <input
                                class="bg-zinc-100 block w-full px-3 py-3 border rounded-md mb-3 border-zinc-200 outline-none focus:border-blue-400"
                                type="text" placeholder="Full Name" name="fullname" required>

                            <input
                                class="bg-zinc-100 block w-full px-3 py-3 border rounded-md mb-3 border-zinc-200 outline-none focus:border-blue-400"
                                type="email" placeholder="Email" name="email" required>

                            <input
                                class="bg-zinc-100 block w-full px-3 py-3 border rounded-md mb-3 border-zinc-200 outline-none focus:border-blue-400"
                                type="password" placeholder="Password" name="password" required>

                            <button
                                class="w-full sm:w-auto px-6 py-3 mt-2 bg-blue-500 hover:bg-blue-600 text-white rounded-full transition duration-200"
                                type="submit">
                                Create My Account
                            </button>

                        </form>
                    </div>
                </div>

                <!-- Login Section -->
                <div class="w-full lg:w-1/2 flex items-center justify-center py-8 lg:py-0">
                    <div class="w-full max-w-md px-2 sm:px-4">

                        <h4 class="text-2xl sm:text-3xl font-medium capitalize mb-5">
                            Login to your account
                        </h4>

                        <form autocomplete="off" action="/users/login" method="post">

                            <input
                                class="block bg-zinc-100 w-full px-3 py-3 border rounded-md mb-3 border-zinc-200 outline-none focus:border-blue-400"
                                type="email" placeholder="Email" name="email" required>

                            <input
                                class="block bg-zinc-100 w-full px-3 py-3 border rounded-md mb-3 border-zinc-200 outline-none focus:border-blue-400"
                                type="password" placeholder="Password" name="password" required>

                            <button
                                class="w-full sm:w-auto px-6 py-3 mt-2 bg-blue-500 hover:bg-blue-600 text-white rounded-full transition duration-200"
                                type="submit">
                                Login
                            </button>

                        </form>
                    </div>
                </div>

            </div>

            <%- include('./partials/footer') %>