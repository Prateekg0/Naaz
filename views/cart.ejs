
<%- include('./partials/header') %>

<div class="w-full  mt-6 min-h-screen px-4 sm:px-6 md:px-10 lg:px-16 py-6 md:py-10">

    <!-- Cart Heading -->
    <h2 class="text-2xl sm:text-3xl font-semibold mb-5">
        My Cart
    </h2>

    <% if (carts.length > 0) { %>

        <!-- Product Cards Slider -->
        <div id="scrollbar-hide" style="scrollbar-width: none; -ms-overflow-style: none;" class="w-full overflow-x-auto pb-5 scroll-smooth snap-x snap-mandatory ">
            <div class="flex gap-4 sm:gap-6 w-max">

                <% carts.forEach(function(cart) { %>

                    <!-- Product Card -->
                    <div class="w-[280px] sm:w-[320px] shrink-0 rounded-xl overflow-hidden shadow-md snap-start">

                        <!-- Product Image -->
                        <div
                            class="w-full h-56 sm:h-64 flex items-center justify-center bg-[<%= cart.bgcolor %>]"
                        >
                            <img
                                class="max-h-[75%] max-w-[85%] object-contain"
                                src="data:image/jpeg;base64,<%= cart.image.toString('base64') %>"
                                alt="<%= cart.name %>"
                                loading="lazy"
                            >
                        </div>

                        <!-- Product Name -->
                        <div
                            class="w-full flex items-center justify-between gap-3 px-4 py-4 bg-[<%= cart.panelcolor %>]"
                        >
                            <h3 class="text-base sm:text-lg font-medium text-black break-words">
                                <%= cart.name %>
                            </h3>

                            <!-- Quantity Display -->
                            <div class="flex items-center gap-2 shrink-0">
                                <button
                                    type="button"
                                    class="w-8 h-8 bg-white rounded-full flex items-center justify-center"
                                    aria-label="Decrease quantity"
                                    disabled
                                >
                                    <i class="ri-subtract-line"></i>
                                </button>

                                <div class="px-3 py-2 rounded-md bg-white text-black text-sm">
                                    01
                                </div>

                                <button
                                    type="button"
                                    class="w-8 h-8 bg-white rounded-full flex items-center justify-center"
                                    aria-label="Increase quantity"
                                    disabled
                                >
                                    <i class="ri-add-line"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Net Total -->
                        <div class="flex items-center justify-between px-4 py-3 bg-neutral-200">
                            <h4 class="text-base font-medium">Net Total</h4>
                            <h2 class="text-base font-semibold">
                                ₹ <%= cart.price %>
                            </h2>
                        </div>

                    </div>

                <% }) %>

            </div>
        </div>

        

        <!-- Price Breakdown -->
        <div class="w-full mt-4 lg:mt-8">

            <h3 class="text-xl sm:text-2xl font-semibold">
                Price Breakdown
            </h3>

            <div class="mt-5 space-y-4">

                <div class="flex justify-between gap-4">
                    <h4 class="text-gray-600">Total MRP</h4>
                    <h4 class="font-medium">
                        ₹ <%= carts.reduce((sum, cart) => sum + Number(cart.price), 0) %>
                    </h4>
                </div>

                <div class="flex justify-between gap-4">
                    <h4 class="text-gray-600">Discount on MRP</h4>
                    <h4 class="font-medium">
                        ₹ <%= carts.reduce((sum, cart) => sum + Number(cart.discount), 0) %>
                    </h4>
                </div>

                <div class="flex justify-between gap-4">
                    <h4 class="text-gray-600">Platform Fee</h4>
                    <h4 class="font-medium">₹ 20</h4>
                </div>

                <div class="flex justify-between gap-4">
                    <h4 class="text-gray-600">Shipping Fee</h4>
                    <h4 class="font-medium text-green-600">FREE</h4>
                </div>

            </div>

            <!-- Divider -->
            <div class="w-full h-px bg-neutral-300 mt-6"></div>

            <!-- Total Amount -->
            <div class="flex items-center justify-between gap-4 mt-5">
                <h3 class="text-lg sm:text-2xl font-semibold">
                    Total Amount
                </h3>

                <% let Total = carts.reduce(
                    (sum, cart) => sum + Number(cart.price) - Number(cart.discount),
                    0
                ) + 20; %>

                <h3 class="font-semibold text-xl sm:text-2xl text-green-600">
                    ₹ <%= Total %>
                </h3>
            </div>

        </div>

    <% } else { %>

        <!-- Empty Cart -->
        <div class="flex flex-col items-center justify-center py-16 text-center">
            <i class="ri-shopping-cart-line text-5xl text-gray-400"></i>

            <h3 class="text-xl font-semibold mt-4">
                Your cart is empty
            </h3>

            <p class="text-gray-500 mt-2">
                Add some products to get started.
            </p>

            <a
                href="/shop"
                class="mt-5 px-6 py-3 rounded-full bg-blue-500 text-white hover:bg-blue-600"
            >
                Continue Shopping
            </a>
        </div>

    <% } %>

</div>

<%- include('./partials/footer') %>
