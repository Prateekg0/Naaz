<%- include('./partials/header') %>
<% carts.forEach(function(cart){%>
<div class="w-full min-h-screen flex items-start px-6 md:px-20 py-10 md:py-20 gap-8 md:gap-12">

    <!-- Product Card -->
    <div class="w-full md:w-[32%] rounded-md overflow-hidden">

        <!-- Product Image -->
        <div class="w-full h-80 flex items-center justify-center   bg-[<%= cart.bgcolor %>]">
            <img class="h-[12rem] " src="data:image/jpeg;base64,<%= cart.image.toString('base64') %>"
                                alt="">
        </div>

        <!-- Product Name + Quantity -->
        <div class="w-full flex items-center justify-between px-5 py-4 bg-[<%= cart.panelcolor %>]">
            <h3 class="text-2xl text-black"><%= cart.name %></h3>

            <div class="flex items-center gap-2">
                <i class="w-8 h-8 bg-white flex rounded-full items-center justify-center ri-add-line"></i>

                <div class="px-3 py-2 rounded-md bg-white text-black">
                    01
                </div>

                <i class="w-8 h-8 bg-white flex rounded-full items-center justify-center ri-subtract-line"></i>
            </div>
        </div>

        <!-- Net Total -->
        <div class="flex items-center justify-between px-5 py-3 bg-neutral-400">
            <h4 class="text-lg">Net Total</h4>
           
            <h2 class="text-lg">₹ <%= cart.price %></h2>
        </div>

    </div>


    <!-- Price Breakdown -->
    <div class="w-full md:w-[68%]">

        <h3 class="text-xl md:text-2xl">Price Breakdown</h3>

        <div class="px-6 md:px-12 mt-6">

            <div class="flex mt-4">
                <h4 class="w-1/2 md:w-1/3">Total MRP</h4>
                <h4>₹ <%= cart.price %></h4>
            </div>

            <div class="flex mt-4">
                <h4 class="w-1/2 md:w-1/3">Discount on MRP</h4>
                <h4>₹ <%= cart.discount %></h4>
            </div>

            <div class="flex mt-4">
                <h4 class="w-1/2 md:w-1/3">Platform Fee</h4>
                <h4>₹ 20</h4>
            </div>

            <div class="flex mt-4">
                <h4 class="w-1/2 md:w-1/3">Shipping Fee</h4>
                <h4>FREE</h4>
            </div>

        </div>

        <!-- Divider -->
        <div class="w-full h-[2px] bg-neutral-600 mt-12"></div>

        <!-- Total Amount -->
        <div class="flex items-center mt-6">
            <h3 class="w-1/2 md:w-1/3 text-xl md:text-2xl">
                Total Amount
            </h3>
             <% let Total = (cart.price+20)-cart.discount %>
            <h3 class="font-semibold text-xl md:text-2xl text-green-600">

                ₹ <%= Total %>
            </h3>
        </div>

        <form action=""></form>

    </div>

</div>
<% } ) %>

<%- include('./partials/footer') %>
